    {
      "parameters": {
        "jsCode": "// Üç budağın nəticəsini bir cavaba çevirir.\nconst oxu = $('Cavabı oxu').first().json;\nconst gelenler = $input.all().map((i) => i.json);\nconst ilk = gelenler[0] || {};\n\nlet cavab;\nswitch (oxu.niyyet) {\n  case 'siyahi':\n    cavab = gelenler.length\n      ? gelenler.map((s) => `${s.id} — ${s.domain}`).join('\\n')\n      : 'Bazada hələ analiz edilmiş sayt yoxdur.';\n    break;\n  case 'analiz':\n    cavab = ilk.analiz_id\n      ? `Analiz başladı: ${ilk.url} (analiz_id ${ilk.analiz_id}). Bitəndən sonra sual verə bilərsən.`\n      : `Analiz başlamadı: ${ilk.message || 'naməlum səbəb'}`;\n    break;\n  case 'sohbet':\n    cavab = ilk.cavab || `Cavab alınmadı: ${ilk.message || 'naməlum səbəb'}`;\n    break;\n  default:\n    cavab =\n      'Sualı təsnif edə bilmədim. Nümunələr: \"hansı saytlar var?\", ' +\n      '\"https://example.com analiz et\", \"bu saytda hansı xidmətlər var?\"';\n}\n\nreturn [{ json: { niyyet: oxu.niyyet, cavab } }];"
      },
      "id": "wf4-yig",
      "name": "Cavabı yığ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
