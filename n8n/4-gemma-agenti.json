      "webhookId": "8f2c1a10-3333-4a10-9a01-saytlupa0004"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Sual: {{ $json.body.sual }}",
        "messages": {
          "messageValues": [
            {
              "message": "Sən təsnifatçısan. İstifadəçinin sualını oxu və YALNIZ JSON qaytar — izahat, giriş sözü, markdown yazma.\n\nSxem:\n{\"niyyet\": \"analiz\" | \"sohbet\" | \"siyahi\", \"sayt_url\": \"\", \"site_id\": null}\n\nQaydalar:\n- \"analiz\" — istifadəçi YENİ bir saytın linkini verib analiz istəyir; sayt_url doldurulur\n- \"sohbet\" — artıq analiz edilmiş saytın məzmunu haqqında sual verir\n- \"siyahi\" — bazada hansı saytların olduğunu soruşur\n\nNümunələr:\nSual: \"https://asan.gov.az saytını analiz et\"\n{\"niyyet\":\"analiz\",\"sayt_url\":\"https://asan.gov.az\",\"site_id\":null}\n\nSual: \"hansı saytlar var?\"\n{\"niyyet\":\"siyahi\",\"sayt_url\":\"\",\"site_id\":null}\n\nSual: \"bu saytda hansı xidmətlər göstərilir?\"\n{\"niyyet\":\"sohbet\",\"sayt_url\":\"\",\"site_id\":null}"
            }
          ]
        }
      },
      "id": "wf4-tesnifat",
      "name": "Gemma — təsnifat",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        -640,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemma3:4b",
        "options": {
          "temperature": 0
        }
      },
      "id": "wf4-ollama",
      "name": "Ollama — Gemma 3",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        -600,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "// Gemma bəzən JSON-u ``` içində və ya izahatla birlikdə qaytarır —\n// ona görə cavabdan JSON hissəsini kəsib oxuyuruq.\nconst xam = $json.text || '';\nconst govde = $('Webhook').first().json.body || {};\n\nlet n = {};\ntry {\n  const temiz = xam.replace(/```json/gi, '').replace(/```/g, '').trim();\n  const bas = temiz.indexOf('{');\n  const son = temiz.lastIndexOf('}');\n  if (bas >= 0 && son > bas) n = JSON.parse(temiz.slice(bas, son + 1));\n} catch (e) {\n  n = {};\n}\n\nconst icaze = ['analiz', 'sohbet', 'siyahi'];\nconst niyyet = icaze.includes(n.niyyet) ? n.niyyet : 'namelum';\n\nreturn [{\n  json: {\n    niyyet,\n    sual: govde.sual || '',\n    sayt_url: n.sayt_url || govde.url || '',\n    // site_id: əvvəlcə sorğudakı, sonra modelin tapdığı, sonra ilk sayt\n    site_id: govde.site_id || n.site_id || 1,\n    xam_cavab: xam,\n  },\n}];"
      },
      "id": "wf4-oxu",
      "name": "Cavabı oxu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
