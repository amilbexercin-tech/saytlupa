# --- LLM açarları (heç biri məcburi deyil — olmasa mock rejim işləyir) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Modellər ---
CLAUDE_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma3:1b

# --- Verilənlər bazası (boş olsa SQLite işlədilir) ---
DATABASE_URL=postgresql+psycopg2://saytlupa:saytlupa@localhost:5432/saytlupa
# Docker-də `api` konteyneri `db`-dən tez qalxa bilər. Bu qədər saniyə Postgres
# gözlənilir; 0 = bir dəfə yoxla və keç (lokal inkişaf üçün).
# Baza cavab verməsə layihə SQLite-a keçir və /api/health bunu xəbərdarlıq kimi
# göstərir — səssiz enmə olmur.
DB_GOZLEME_SANIYE=0

# --- Redis (boş olsa yaddaşdaxili keş işlədilir) ---
REDIS_URL=redis://localhost:6379/0

# --- n8n ---
N8N_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PageSpeed (boş olsa sürət analizi keçilir) ---
PAGESPEED_API_KEY=

# --- ai-website-cloner şablonunun yerli nüsxəsi (klon hazırlığı düyməsi üçün) ---
# Boş olsa sənədlər yenə yazılır, sadəcə köçürmə əmrində yolu özün yazırsan.
# SaytLupa bu qovluğa heç vaxt özü yazmır.
CLONER_YOLU=

# --- Giriş qoruması ---
# Boş olsa heç bir məhdudiyyət yoxdur — lokal inkişafda belə qalsın.
# Serverdə mütləq doldurulmalıdır: analiz və təhvil düymələri pullu model
# çağırışıdır, açarsız qalsa ünvanı bilən hər kəs sənin hesabından xərcləyər.
# Uzun təsadüfi dəyər yarat:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_ACAR=
# Açarı olmayan ziyarətçi gündə neçə sual verə bilər (IP başına)
GUNLUK_SUAL_LIMITI=5

# --- Crawler limitləri ---
MAX_PAGES=30
REQUEST_TIMEOUT=15

# --- Re-ranking: "" (söndürülüb) | "gemma" (lokal) | "gemini" (bulud) ---
RERANK=

# ===========================================================================
# YALNIZ SERVERDƏ (docker-compose.prod.yml)
# Lokalda bunlar boş qala bilər — compose faylı onları oxumur.
# ===========================================================================

# Postgres. Parolu mütləq dəyiş — lokaldakı "saytlupa" parolu serverdə olmaz.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=saytlupa
POSTGRES_DB=saytlupa
POSTGRES_PASSWORD=

# Ünvanlar. Caddy sertifikatı bunlara görə alır, yəni hər ikisi həqiqətən
# serverin IP-sinə baxmalıdır. Domen almasan sslip.io pulsuz işləyir:
#   SAYT_HOST=203.0.113.10.sslip.io
#   N8N_HOST=n8n.203.0.113.10.sslip.io
SAYT_HOST=
N8N_HOST=
